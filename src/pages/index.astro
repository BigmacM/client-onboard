      document.getElementById('contactEmail').value = 'john@mapleleafbistro.ca';
      document.getElementById('contactPhone').value = '+1 (647) 555-1234';
      document.getElementById('preferredContact').value = 'email';

      // Business Information (NAP)
      document.getElementById('businessName').value = 'Maple Leaf Bistro';
      document.getElementById('businessType').value = 'Restaurant & Bar';
      document.getElementById('yearEstablished').value = '2019';
      document.getElementById('businessAddress').value = '456 Queen Street West';
      document.getElementById('city').value = 'Toronto';
      document.getElementById('province').value = 'ON';
      document.getElementById('postalCode').value = 'M5V 2B3';
      document.getElementById('businessPhone').value = '+1 (416) 555-9876';
      document.getElementById('businessEmail').value = 'hello@mapleleafbistro.ca';
      document.getElementById('businessHours').value = 'Mon-Thu: 11am - 10pm\nFri-Sat: 11am - 11pm\nSun: 10am - 9pm (Brunch from 10am)';
      document.getElementById('serviceAreas').value = 'Downtown Toronto, Entertainment District, King West';

      // About Business
      document.getElementById('aboutBusiness').value = 'Maple Leaf Bistro is a modern Canadian restaurant celebrating local, seasonal ingredients. We partner with Ontario farmers and producers to create dishes that showcase the best of Canadian cuisine with a contemporary twist. Our warm, welcoming atmosphere makes us perfect for date nights, family gatherings, and business lunches.';
      document.getElementById('uniqueValue').value = 'Farm-to-table dining with 90% of ingredients sourced within 100km. Award-winning chef with Michelin experience. Private dining room available. Voted "Best New Restaurant 2020" by Toronto Life.';
      document.getElementById('servicesOffered').value = '- Lunch & Dinner Service\n- Weekend Brunch\n- Private Event Catering\n- Private Dining Room Rental\n- Takeout & Delivery\n- Gift Cards\n- Cooking Classes (Monthly)';
      document.getElementById('targetAudience').value = 'Food enthusiasts 28-55, couples looking for date night spots, business professionals for lunch meetings, families celebrating special occasions';
      document.getElementById('competitors').value = 'Canoe Restaurant - canoerestaurant.com\nActinolite - actinoliterestaurant.com\nRichmond Station - richmondstation.ca';

      // Online Presence
      document.getElementById('existingWebsite').value = 'https://mapleleafbistro-old.wixsite.com';
      document.querySelector('input[name="hasDomain"][value="yes"]').checked = true;
      document.getElementById('domainName').value = 'mapleleafbistro.ca';
      document.querySelector('input[name="hasGMB"][value="yes-claimed"]').checked = true;
      document.getElementById('socialLinks').value = 'Instagram: @mapleleafbistro (12.5k followers)\nFacebook: facebook.com/mapleleafbistro\nTikTok: @mapleleafbistro';
      document.getElementById('reviewProfiles').value = 'Google: 4.7 stars (340 reviews)\nYelp: 4.5 stars (89 reviews)\nTripAdvisor: 4.5 stars (156 reviews)';

      // Branding
      document.querySelector('input[name="hasLogo"][value="yes-vector"]').checked = true;
      document.getElementById('brandColors').value = '#2D5016 (Forest Green), #D4A574 (Warm Tan), #1a1a1a (Black), #FFFFF (Cream)';
      document.getElementById('brandFonts').value = 'Playfair Display for headings, Lato for body text';
      document.querySelector('input[name="hasPhotos"][value="yes"]').checked = true;

      // Website Requirements
      document.getElementById('websiteType').value = 'business';

      // Check pages
      ['home', 'about', 'services', 'gallery', 'contact', 'booking'].forEach(page => {
        const checkbox = document.querySelector(`input[name="pages"][value="${page}"]`);
        if (checkbox) checkbox.checked = true;
      });

      // Check features
      ['contact-form', 'booking', 'social-feed', 'reviews', 'maps', 'analytics', 'seo'].forEach(feature => {
        const checkbox = document.querySelector(`input[name="features"][value="${feature}"]`);
        if (checkbox) checkbox.checked = true;
      });

      document.getElementById('websiteInspiration').value = 'https://www.canoerestaurant.com - Love the elegant layout\nhttps://www.alorestaurant.com - Great use of food photography\nhttps://www.richmondstation.ca - Like their menu presentation';
      document.getElementById('websiteGoals').value = 'Primary: Drive online reservations through OpenTable integration\nSecondary: Showcase our food with beautiful photography\nTertiary: Build email list for special events and promotions';

      // Content
      document.querySelector('input[name="hasContent"][value="partial"]').checked = true;
      document.getElementById('tagline').value = 'Farm to Table, Heart to Soul';
      document.getElementById('callToAction').value = 'Reserve Your Table';
      document.getElementById('keywords').value = 'farm to table toronto, best restaurants queen west, canadian cuisine toronto, private dining toronto, brunch toronto';
      document.getElementById('toneOfVoice').value = 'friendly';

      // Project Details
      document.getElementById('budget').value = '2500-5000';
      document.getElementById('timeline').value = '1-month';

      // Check additional services
      ['copywriting', 'seo', 'photography'].forEach(service => {
        const checkbox = document.querySelector(`input[name="additionalServices"][value="${service}"]`);
        if (checkbox) checkbox.checked = true;
      });

      document.getElementById('additionalNotes').value = 'We have a new seasonal menu launching in 6 weeks and would love the website ready by then. Also interested in discussing ongoing SEO services. Our current Wix site is very outdated and not mobile-friendly.';
      document.getElementById('howDidYouHear').value = 'referral';

      // Trigger progress update
      updateProgress();

      // Scroll to top and show confirmation
      window.scrollTo({ top: 0, behavior: 'smooth' });
      fillTestDataBtn.innerHTML = '<span class="flex items-center justify-center gap-2"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Test Data Filled!</span>';
      fillTestDataBtn.classList.remove('border-yellow-500/50', 'bg-yellow-500/10', 'text-yellow-400', 'hover:bg-yellow-500/20', 'hover:border-yellow-500');
      fillTestDataBtn.classList.add('border-green-500/50', 'bg-green-500/10', 'text-green-400');

      setTimeout(() => {
        fillTestDataBtn.innerHTML = '<span class="flex items-center justify-center gap-2"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>Fill Form with Test Data</span>';
        fillTestDataBtn.classList.add('border-yellow-500/50', 'bg-yellow-500/10', 'text-yellow-400', 'hover:bg-yellow-500/20', 'hover:border-yellow-500');
        fillTestDataBtn.classList.remove('border-green-500/50', 'bg-green-500/10', 'text-green-400');
      }, 2000);
    });

    // Progress tracking
    function updateProgress() {
      const requiredFields = form.querySelectorAll('[required]');
      const filledFields = Array.from(requiredFields).filter(field => field.value.trim() !== '');
      const percentage = Math.round((filledFields.length / requiredFields.length) * 100);
      progressBar.style.width = `${percentage}%`;
      progressText.textContent = `${percentage}%`;
    }

    form.addEventListener('input', updateProgress);
    form.addEventListener('change', updateProgress);

    // Image handling
    function handleFiles(files) {
      const newFiles = Array.from(files).filter(file => file.type.startsWith('image/'));
      selectedFiles = [...selectedFiles, ...newFiles];
      renderPreviews();
    }

    function renderPreviews() {
      imagePreviews.innerHTML = '';
      selectedFiles.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const div = document.createElement('div');
          div.className = 'relative aspect-square';
          div.innerHTML = `
            <img src="${e.target.result}" class="h-full w-full rounded-lg object-cover" alt="Preview">
            <button type="button" data-index="${index}" class="remove-image absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-rose-500 text-white shadow-lg hover:bg-rose-400">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          `;
          imagePreviews.appendChild(div);
        };
        reader.readAsDataURL(file);
      });
    }

    imagePreviews.addEventListener('click', (e) => {
      const btn = e.target.closest('.remove-image');
      if (btn) {
        const index = parseInt(btn.dataset.index);
        selectedFiles.splice(index, 1);
        renderPreviews();
      }
    });

    imageInput.addEventListener('change', (e) => handleFiles(e.target.files));

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-indigo-500', 'bg-slate-700/50');
    });

    dropZone.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-indigo-500', 'bg-slate-700/50');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-indigo-500', 'bg-slate-700/50');
      handleFiles(e.dataTransfer.files);
    });

    // Logo handling
    logoInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        logoFile = file;
        logoFileName.textContent = file.name;
        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = (e) => {
            logoPreviewImg.src = e.target.result;
          };
          reader.readAsDataURL(file);
        } else {
          logoPreviewImg.src = 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%236366f1"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/></svg>';
        }
        logoPreview.classList.remove('hidden');
      }
    });

    removeLogo.addEventListener('click', () => {
      logoFile = null;
      logoInput.value = '';
      logoPreview.classList.add('hidden');
    });

    // Menu handling
    function handleMenuFiles(files) {
      const newFiles = Array.from(files).filter(file => file.type.startsWith('image/'));
      newFiles.forEach((file, i) => {
        const pageNum = menuFiles.length + i + 1;
        menuFiles.push({ file, label: `Menu Page ${pageNum}` });
      });
      renderMenuPreviews();
    }

    function renderMenuPreviews() {
      menuPreviews.innerHTML = '';
      menuFiles.forEach((item, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const div = document.createElement('div');
          div.className = 'flex items-center gap-3 p-3 bg-slate-700/50 rounded-xl';
          div.innerHTML = `
            <img src="${e.target.result}" class="h-16 w-16 rounded-lg object-cover flex-shrink-0" alt="Menu page ${index + 1}">
            <div class="flex-1 min-w-0">
              <input type="text" value="${item.label}" data-menu-index="${index}"
                class="menu-label w-full rounded-lg border border-slate-600 bg-slate-800/50 px-3 py-2 text-sm text-white placeholder-slate-400 focus:border-amber-500 focus:outline-none"
                placeholder="Label this page (e.g., Appetizers, Mains, Drinks)">
              <p class="mt-1 text-xs text-slate-400 truncate">${item.file.name}</p>
            </div>
            <button type="button" data-menu-remove="${index}" class="flex-shrink-0 text-rose-400 hover:text-rose-300 p-1">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          `;
          menuPreviews.appendChild(div);
        };
        reader.readAsDataURL(item.file);
      });
    }

    menuInput.addEventListener('change', (e) => handleMenuFiles(e.target.files));

    menuDropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      menuDropZone.classList.add('border-amber-400', 'bg-slate-700/50');
    });

    menuDropZone.addEventListener('dragleave', (e) => {
      e.preventDefault();
      menuDropZone.classList.remove('border-amber-400', 'bg-slate-700/50');
    });

    menuDropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      menuDropZone.classList.remove('border-amber-400', 'bg-slate-700/50');
      handleMenuFiles(e.dataTransfer.files);
    });

    // Update menu labels and handle removal
    menuPreviews.addEventListener('input', (e) => {
      if (e.target.classList.contains('menu-label')) {
        const index = parseInt(e.target.dataset.menuIndex);
        menuFiles[index].label = e.target.value;
      }
    });

    menuPreviews.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-menu-remove]');
      if (btn) {
        const index = parseInt(btn.dataset.menuRemove);
        menuFiles.splice(index, 1);
        renderMenuPreviews();
      }
    });

    // Collect all form data
    function collectFormData() {
      const data = {};

      // Text inputs and textareas
      const textFields = form.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], input[type="url"], input[type="number"], textarea, select');
      textFields.forEach(field => {
        if (field.name && field.value) {
          data[field.name] = field.value;
        }
      });

      // Radio buttons
      const radioGroups = {};
      form.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
        radioGroups[radio.name] = radio.value;
      });
      Object.assign(data, radioGroups);

      // Checkboxes
      const checkboxGroups = {};
      form.querySelectorAll('input[type="checkbox"]:checked').forEach(checkbox => {
        if (!checkboxGroups[checkbox.name]) {
          checkboxGroups[checkbox.name] = [];
        }
        checkboxGroups[checkbox.name].push(checkbox.value);
      });
      Object.keys(checkboxGroups).forEach(key => {
        data[key] = checkboxGroups[key].join(', ');
      });

      return data;
    }

    // Generate review content
    function generateReviewContent(data) {
      const sections = [
        { title: 'Contact Information', fields: ['contactName', 'contactRole', 'contactEmail', 'contactPhone', 'preferredContact'] },
        { title: 'Business Information', fields: ['businessName', 'businessType', 'yearEstablished', 'businessAddress', 'city', 'province', 'postalCode', 'businessPhone', 'businessEmail', 'businessHours', 'serviceAreas'] },
        { title: 'About Your Business', fields: ['aboutBusiness', 'uniqueValue', 'servicesOffered', 'targetAudience', 'competitors'] },
        { title: 'Online Presence', fields: ['existingWebsite', 'hasDomain', 'domainName', 'hasGMB', 'socialLinks', 'reviewProfiles'] },
        { title: 'Branding', fields: ['hasLogo', 'brandColors', 'brandFonts', 'hasPhotos'] },
        { title: 'Website Requirements', fields: ['websiteType', 'menuType', 'showPrices', 'needQRPrint', 'menuNotes', 'pages', 'features', 'websiteInspiration', 'websiteGoals'] },
        { title: 'Content', fields: ['hasContent', 'tagline', 'callToAction', 'keywords', 'toneOfVoice'] },
        { title: 'Project Details', fields: ['budget', 'timeline', 'additionalServices', 'additionalNotes', 'howDidYouHear'] }
      ];

      const fieldLabels = {
        contactName: 'Name', contactRole: 'Role', contactEmail: 'Email', contactPhone: 'Phone', preferredContact: 'Preferred Contact',
        businessName: 'Business Name', businessType: 'Industry', yearEstablished: 'Year Established', businessAddress: 'Address',
        city: 'City', province: 'Province/State', postalCode: 'Postal Code', businessPhone: 'Business Phone', businessEmail: 'Business Email',
        businessHours: 'Hours', serviceAreas: 'Service Areas', aboutBusiness: 'Description', uniqueValue: 'Unique Value',
        servicesOffered: 'Services', targetAudience: 'Target Audience', competitors: 'Competitors', existingWebsite: 'Current Website',
        hasDomain: 'Has Domain', domainName: 'Domain', hasGMB: 'Google Business Profile', socialLinks: 'Social Media', reviewProfiles: 'Review Profiles',
        hasLogo: 'Has Logo', brandColors: 'Colors', brandFonts: 'Fonts', hasPhotos: 'Has Photos',
        websiteType: 'Website Type', menuType: 'Menu Type', showPrices: 'Show Prices', needQRPrint: 'QR Print Materials', menuNotes: 'Menu Notes', pages: 'Pages', features: 'Features', websiteInspiration: 'Inspiration', websiteGoals: 'Goals',
        hasContent: 'Has Content', tagline: 'Tagline', callToAction: 'CTA', keywords: 'Keywords', toneOfVoice: 'Tone',
        budget: 'Budget', timeline: 'Timeline', additionalServices: 'Additional Services', additionalNotes: 'Notes', howDidYouHear: 'Referral Source'
      };

      let html = '';
      sections.forEach(section => {
        const sectionFields = section.fields.filter(f => data[f]);
        if (sectionFields.length > 0) {
          html += `<div class="rounded-xl bg-slate-700/50 p-4">
            <p class="text-xs font-medium uppercase tracking-wider text-indigo-400 mb-3">${section.title}</p>
            <div class="space-y-2">`;
          sectionFields.forEach(field => {
            html += `<div><span class="text-slate-400 text-sm">${fieldLabels[field] || field}:</span> <span class="text-white text-sm">${data[field]}</span></div>`;
          });
          html += '</div></div>';
        }
      });

      if (selectedFiles.length > 0) {
        html += `<div class="rounded-xl bg-slate-700/50 p-4">
          <p class="text-xs font-medium uppercase tracking-wider text-indigo-400 mb-3">Uploaded Images</p>
          <p class="text-white text-sm">${selectedFiles.length} image(s) selected</p>
        </div>`;
      }

      if (logoFile) {
        html += `<div class="rounded-xl bg-slate-700/50 p-4">
          <p class="text-xs font-medium uppercase tracking-wider text-indigo-400 mb-3">Logo</p>
          <p class="text-white text-sm">${logoFile.name}</p>
        </div>`;
      }

      if (menuFiles.length > 0) {
        html += `<div class="rounded-xl bg-amber-500/10 border border-amber-500/30 p-4">
          <p class="text-xs font-medium uppercase tracking-wider text-amber-400 mb-3">Menu Pages (${menuFiles.length})</p>
          <div class="space-y-1">
            ${menuFiles.map((m, i) => `<p class="text-white text-sm">${i + 1}. ${m.label}</p>`).join('')}
          </div>
        </div>`;
      }

      return html;
    }

    // Form submission
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      formData = collectFormData();
      reviewContent.innerHTML = generateReviewContent(formData);
      reviewModal.classList.remove('hidden');
      reviewModal.classList.add('flex');
    });

    editBtn.addEventListener('click', () => {
      reviewModal.classList.add('hidden');
      reviewModal.classList.remove('flex');
    });

    confirmBtn.addEventListener('click', async () => {
      reviewModal.classList.add('hidden');
      reviewModal.classList.remove('flex');
      loadingOverlay.classList.remove('hidden');
      loadingOverlay.classList.add('flex');

      try {
        // Convert images to base64
        const imagePromises = selectedFiles.map(file => {
          return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve({ name: file.name, type: file.type, data: e.target.result });
            reader.readAsDataURL(file);
          });
        });

        const images = await Promise.all(imagePromises);

        let logoData = null;
        if (logoFile) {
          logoData = await new Promise((resolve) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve({ name: logoFile.name, type: logoFile.type, data: e.target.result });
            reader.readAsDataURL(logoFile);
          });
        }

        // Convert menu images to base64 with labels
        const menuPromises = menuFiles.map(item => {
          return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve({
              name: item.file.name,
              type: item.file.type,
              label: item.label,
              data: e.target.result
            });
            reader.readAsDataURL(item.file);
          });
        });
        const menuImages = await Promise.all(menuPromises);

        await fetch(GOOGLE_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...formData,
            logo: logoData,
            images: images,
            menuImages: menuImages,
            timestamp: new Date().toISOString()
          })
        });

        loadingOverlay.classList.add('hidden');
        loadingOverlay.classList.remove('flex');
        successModal.classList.remove('hidden');
        successModal.classList.add('flex');

      } catch (error) {
        console.error('Submission error:', error);
        loadingOverlay.classList.add('hidden');
        loadingOverlay.classList.remove('flex');
        alert('There was an error submitting your form. Please try again.');
      }
    });

    openWhatsAppBtn.addEventListener('click', () => {
      let menuInfo = '';
      if (formData.websiteType === 'menu-qr' && menuFiles.length > 0) {
        menuInfo = `\n*Menu Pages:* ${menuFiles.length} uploaded\n*Menu Labels:* ${menuFiles.map(m => m.label).join(', ')}\n`;
      }

      const message = encodeURIComponent(
        `*New Client Intake*\n\n` +
        `*Business:* ${formData.businessName || 'N/A'}\n` +
        `*Contact:* ${formData.contactName || 'N/A'}\n` +
        `*Phone:* ${formData.contactPhone || 'N/A'}\n` +
        `*Email:* ${formData.contactEmail || 'N/A'}\n` +
        `*Type:* ${formData.businessType || 'N/A'}\n` +
        `*Website Type:* ${formData.websiteType || 'N/A'}\n` +
        menuInfo +
        `*Budget:* ${formData.budget || 'N/A'}\n` +
        `*Timeline:* ${formData.timeline || 'N/A'}\n\n` +
        `*Images:* ${selectedFiles.length} uploaded`
      );
      window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`, '_blank');
    });

    [reviewModal, successModal].forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      });
    });
  </script>

  <style>
    #reviewModal > div::-webkit-scrollbar { width: 6px; }
    #reviewModal > div::-webkit-scrollbar-track { background: transparent; }
    #reviewModal > div::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
    input[type="radio"], input[type="checkbox"] {
      accent-color: #6366f1;
    }
  </style>
</body>
</html>
