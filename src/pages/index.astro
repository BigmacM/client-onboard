---
// Client Intake Form - Comprehensive Web Development Onboarding
const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyQGF_PlOUrBXXBRtnPet20qQCPV3Adtk0BMAWyWTESYChZXzQDQT4IKNsXnSgoXKEA/exec";
const WHATSAPP_NUMBER = "16479094565";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Client onboarding form - Tell us about your business" />
  <title>Client Onboarding</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📋</text></svg>" />
</head>
<body class="bg-slate-900">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-4 py-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <!-- Header -->
      <div class="mb-8 text-center">
        <!-- Nika Marketing Logo -->
        <div class="mb-6">
          <a href="https://nikamarketing.com" target="_blank" rel="noopener noreferrer" class="inline-block">
            <img
              src="https://nikamarketing.com/wp-content/uploads/2024/02/nika_logo.png"
              alt="Nika Marketing"
              class="h-12 sm:h-14 mx-auto hover:opacity-80 transition-opacity"
            />
          </a>
        </div>
        <h1 class="text-3xl font-bold text-white sm:text-4xl">Client Onboarding</h1>
        <p class="mt-2 text-slate-400">Help us understand your business to build the perfect website</p>
      </div>

      <!-- TEST DATA BUTTON - Remove before production -->
      <div class="mb-6">
        <button
          type="button"
          id="fillTestDataBtn"
          class="w-full rounded-xl border-2 border-dashed border-yellow-500/50 bg-yellow-500/10 px-4 py-3 text-yellow-400 font-medium transition-all hover:bg-yellow-500/20 hover:border-yellow-500"
        >
          <span class="flex items-center justify-center gap-2">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
            Fill Form with Test Data
          </span>
        </button>
      </div>

      <!-- Progress Indicator -->
      <div class="mb-8">
        <div class="flex justify-between text-xs text-slate-400 mb-2">
          <span>Progress</span>
          <span id="progressText">0%</span>
        </div>
        <div class="h-2 bg-slate-700 rounded-full overflow-hidden">
          <div id="progressBar" class="h-full bg-indigo-500 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <!-- Form -->
      <form id="intakeForm" class="space-y-8">

        <!-- Section 1: Contact Information -->
        <section class="rounded-2xl bg-slate-800/50 p-6 shadow-xl backdrop-blur-sm sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-500/20">
              <svg class="h-5 w-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-white">Contact Information</h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="contactName" class="mb-2 block text-sm font-medium text-slate-200">
                  Your Name <span class="text-rose-400">*</span>
                </label>
                <input type="text" id="contactName" name="contactName" required placeholder="John Smith"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
              <div>
                <label for="contactRole" class="mb-2 block text-sm font-medium text-slate-200">
                  Your Role
                </label>
                <input type="text" id="contactRole" name="contactRole" placeholder="Owner, Manager, etc."
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="contactEmail" class="mb-2 block text-sm font-medium text-slate-200">
                  Email Address <span class="text-rose-400">*</span>
                </label>
                <input type="email" id="contactEmail" name="contactEmail" required placeholder="john@business.com"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
              <div>
                <label for="contactPhone" class="mb-2 block text-sm font-medium text-slate-200">
                  Phone Number <span class="text-rose-400">*</span>
                </label>
                <input type="tel" id="contactPhone" name="contactPhone" required placeholder="+1 (555) 123-4567"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
            </div>

            <div>
              <label for="preferredContact" class="mb-2 block text-sm font-medium text-slate-200">
                Preferred Contact Method
              </label>
              <select id="preferredContact" name="preferredContact"
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
                <option value="email">Email</option>
                <option value="phone">Phone Call</option>
                <option value="text">Text Message</option>
                <option value="whatsapp">WhatsApp</option>
              </select>
            </div>
          </div>
        </section>

        <!-- Section 2: Business Information (NAP) -->
        <section class="rounded-2xl bg-slate-800/50 p-6 shadow-xl backdrop-blur-sm sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500/20">
              <svg class="h-5 w-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-white">Business Information (NAP)</h2>
          </div>

          <div class="space-y-4">
            <div>
              <label for="businessName" class="mb-2 block text-sm font-medium text-slate-200">
                Business Name <span class="text-rose-400">*</span>
              </label>
              <input type="text" id="businessName" name="businessName" required placeholder="Acme Corporation"
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="businessType" class="mb-2 block text-sm font-medium text-slate-200">
                  Industry/Business Type <span class="text-rose-400">*</span>
                </label>
                <input type="text" id="businessType" name="businessType" required placeholder="Restaurant, Plumbing, Law Firm..."
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
              <div>
                <label for="yearEstablished" class="mb-2 block text-sm font-medium text-slate-200">
                  Year Established
                </label>
                <input type="number" id="yearEstablished" name="yearEstablished" placeholder="2020" min="1900" max="2026"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
            </div>

            <div>
              <label for="businessAddress" class="mb-2 block text-sm font-medium text-slate-200">
                Business Address <span class="text-rose-400">*</span>
              </label>
              <input type="text" id="businessAddress" name="businessAddress" required placeholder="123 Main Street"
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
            </div>

            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
              <div class="col-span-2 sm:col-span-2">
                <label for="city" class="mb-2 block text-sm font-medium text-slate-200">
                  City <span class="text-rose-400">*</span>
                </label>
                <input type="text" id="city" name="city" required placeholder="Toronto"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
              <div>
                <label for="province" class="mb-2 block text-sm font-medium text-slate-200">
                  Province/State
                </label>
                <input type="text" id="province" name="province" placeholder="ON"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
              <div>
                <label for="postalCode" class="mb-2 block text-sm font-medium text-slate-200">
                  Postal Code
                </label>
                <input type="text" id="postalCode" name="postalCode" placeholder="M5V 1A1"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
            </div>

            <div>
              <label for="businessPhone" class="mb-2 block text-sm font-medium text-slate-200">
                Business Phone Number <span class="text-rose-400">*</span>
              </label>
              <input type="tel" id="businessPhone" name="businessPhone" required placeholder="+1 (555) 123-4567"
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              <p class="mt-1 text-xs text-slate-400">This will be displayed on your website</p>
            </div>

            <div>
              <label for="businessEmail" class="mb-2 block text-sm font-medium text-slate-200">
                Business Email
              </label>
              <input type="email" id="businessEmail" name="businessEmail" placeholder="info@yourbusiness.com"
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
            </div>

            <div>
              <label for="businessHours" class="mb-2 block text-sm font-medium text-slate-200">
                Business Hours
              </label>
              <textarea id="businessHours" name="businessHours" rows="3"
                placeholder="Mon-Fri: 9am - 5pm&#10;Sat: 10am - 3pm&#10;Sun: Closed"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>

            <div>
              <label for="serviceAreas" class="mb-2 block text-sm font-medium text-slate-200">
                Service Areas / Locations Served
              </label>
              <input type="text" id="serviceAreas" name="serviceAreas" placeholder="Toronto, Mississauga, Brampton, GTA..."
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
            </div>
          </div>
        </section>

        <!-- Section 3: About the Business -->
        <section class="rounded-2xl bg-slate-800/50 p-6 shadow-xl backdrop-blur-sm sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-500/20">
              <svg class="h-5 w-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-white">About Your Business</h2>
          </div>

          <div class="space-y-4">
            <div>
              <label for="aboutBusiness" class="mb-2 block text-sm font-medium text-slate-200">
                Describe Your Business <span class="text-rose-400">*</span>
              </label>
              <textarea id="aboutBusiness" name="aboutBusiness" required rows="4"
                placeholder="What does your business do? What products or services do you offer?"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>

            <div>
              <label for="uniqueValue" class="mb-2 block text-sm font-medium text-slate-200">
                What Makes You Unique? <span class="text-rose-400">*</span>
              </label>
              <textarea id="uniqueValue" name="uniqueValue" required rows="3"
                placeholder="What sets you apart from competitors? Why should customers choose you?"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>

            <div>
              <label for="servicesOffered" class="mb-2 block text-sm font-medium text-slate-200">
                Services/Products Offered <span class="text-rose-400">*</span>
              </label>
              <textarea id="servicesOffered" name="servicesOffered" required rows="4"
                placeholder="List your main services or products (one per line):&#10;- Service 1&#10;- Service 2&#10;- Service 3"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>

            <div>
              <label for="targetAudience" class="mb-2 block text-sm font-medium text-slate-200">
                Target Audience
              </label>
              <textarea id="targetAudience" name="targetAudience" rows="2"
                placeholder="Who are your ideal customers? (e.g., homeowners, small businesses, young professionals...)"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>

            <div>
              <label for="competitors" class="mb-2 block text-sm font-medium text-slate-200">
                Main Competitors
              </label>
              <textarea id="competitors" name="competitors" rows="2"
                placeholder="List 2-3 competitors or competitor websites"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>
          </div>
        </section>

        <!-- Section 4: Online Presence -->
        <section class="rounded-2xl bg-slate-800/50 p-6 shadow-xl backdrop-blur-sm sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-cyan-500/20">
              <svg class="h-5 w-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-white">Current Online Presence</h2>
          </div>

          <div class="space-y-4">
            <div>
              <label for="existingWebsite" class="mb-2 block text-sm font-medium text-slate-200">
                Existing Website URL (if any)
              </label>
              <input type="url" id="existingWebsite" name="existingWebsite" placeholder="https://www.yourbusiness.com"
                class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200">
                  Do you own a domain name?
                </label>
                <div class="flex gap-4">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="hasDomain" value="yes" class="text-indigo-500 focus:ring-indigo-500" />
                    <span class="text-slate-200">Yes</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="hasDomain" value="no" class="text-indigo-500 focus:ring-indigo-500" />
                    <span class="text-slate-200">No</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="hasDomain" value="unsure" class="text-indigo-500 focus:ring-indigo-500" />
                    <span class="text-slate-200">Not Sure</span>
                  </label>
                </div>
              </div>
              <div>
                <label for="domainName" class="mb-2 block text-sm font-medium text-slate-200">
                  Domain Name (if you have one)
                </label>
                <input type="text" id="domainName" name="domainName" placeholder="yourbusiness.com"
                  class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" />
              </div>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200">
                Do you have Google Business Profile (GMB)?
              </label>
              <div class="flex flex-wrap gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="hasGMB" value="yes-claimed" class="text-indigo-500 focus:ring-indigo-500" />
                  <span class="text-slate-200">Yes, claimed & verified</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="hasGMB" value="yes-unclaimed" class="text-indigo-500 focus:ring-indigo-500" />
                  <span class="text-slate-200">Yes, but not claimed</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="hasGMB" value="no" class="text-indigo-500 focus:ring-indigo-500" />
                  <span class="text-slate-200">No</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="hasGMB" value="unsure" class="text-indigo-500 focus:ring-indigo-500" />
                  <span class="text-slate-200">Not Sure</span>
                </label>
              </div>
            </div>

            <div>
              <label for="socialLinks" class="mb-2 block text-sm font-medium text-slate-200">
                Social Media Links
              </label>
              <textarea id="socialLinks" name="socialLinks" rows="4"
                placeholder="Facebook: &#10;Instagram: &#10;LinkedIn: &#10;Twitter/X: &#10;TikTok: &#10;YouTube: "
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>

            <div>
              <label for="reviewProfiles" class="mb-2 block text-sm font-medium text-slate-200">
                Review Profiles (Yelp, TripAdvisor, etc.)
              </label>
              <textarea id="reviewProfiles" name="reviewProfiles" rows="2"
                placeholder="Links to any review profiles you have"
                class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"></textarea>
            </div>
          </div>
        </section>

        <!-- Section 5: Branding & Assets -->
        <section class="rounded-2xl bg-slate-800/50 p-6 shadow-xl backdrop-blur-sm sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-pink-500/20">
              <svg class="h-5 w-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-white">Branding & Assets</h2>
          </div>

          <div class="space-y-4">
            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200">
                Do you have a logo?
              </label>
              <div class="flex flex-wrap gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="hasLogo" value="yes-vector" class="text-indigo-500 focus:ring-indigo-500" />
                  <span class="text-slate-200">Yes, high quality (vector/PNG)</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="hasLogo" value="yes-low" class="text-indigo-500 focus:ring-indigo-500" />
