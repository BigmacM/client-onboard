---
// Client Intake Form - Single File Astro Component
// Replace these with your actual values
const GOOGLE_SCRIPT_URL = "YOUR_GOOGLE_APPS_SCRIPT_URL";
const WHATSAPP_NUMBER = "YOUR_WHATSAPP_NUMBER"; // e.g., "1234567890" (no + or spaces)
---

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-4 py-8 sm:py-12">
  <div class="mx-auto max-w-lg">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-white sm:text-4xl">Client Onboarding</h1>
      <p class="mt-2 text-slate-400">Tell us about your business</p>
    </div>

    <!-- Form -->
    <form id="intakeForm" class="space-y-6 rounded-2xl bg-slate-800/50 p-6 shadow-xl backdrop-blur-sm sm:p-8">
      <!-- Business Name -->
      <div>
        <label for="businessName" class="mb-2 block text-sm font-medium text-slate-200">
          Business Name <span class="text-rose-400">*</span>
        </label>
        <input
          type="text"
          id="businessName"
          name="businessName"
          required
          placeholder="Enter your business name"
          class="w-full rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
        />
      </div>

      <!-- About -->
      <div>
        <label for="about" class="mb-2 block text-sm font-medium text-slate-200">
          About Your Business <span class="text-rose-400">*</span>
        </label>
        <textarea
          id="about"
          name="about"
          required
          rows="4"
          placeholder="Describe what your business does, your mission, and what makes you unique..."
          class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
        ></textarea>
      </div>

      <!-- Social Links -->
      <div>
        <label for="socialLinks" class="mb-2 block text-sm font-medium text-slate-200">
          Social Media Links
        </label>
        <textarea
          id="socialLinks"
          name="socialLinks"
          rows="3"
          placeholder="Instagram: @yourbusiness&#10;Facebook: facebook.com/yourbusiness&#10;Website: www.yourbusiness.com"
          class="w-full resize-none rounded-xl border border-slate-600 bg-slate-700/50 px-4 py-3 text-white placeholder-slate-400 transition-all focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
        ></textarea>
      </div>

      <!-- Image Upload -->
      <div>
        <label class="mb-2 block text-sm font-medium text-slate-200">
          Upload Images
        </label>
        <div
          id="dropZone"
          class="relative cursor-pointer rounded-xl border-2 border-dashed border-slate-600 bg-slate-700/30 p-8 text-center transition-all hover:border-indigo-500 hover:bg-slate-700/50"
        >
          <input
            type="file"
            id="imageInput"
            name="images"
            accept="image/*"
            multiple
            class="absolute inset-0 cursor-pointer opacity-0"
          />
          <div class="flex flex-col items-center">
            <!-- Camera Icon -->
            <div class="mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-indigo-500/20">
              <svg
                class="h-8 w-8 text-indigo-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
            </div>
            <p class="text-sm font-medium text-slate-200">Tap to upload photos</p>
            <p class="mt-1 text-xs text-slate-400">or drag and drop</p>
          </div>
        </div>
        <!-- Image Previews -->
        <div id="imagePreviews" class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4"></div>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full rounded-xl bg-indigo-600 px-6 py-4 text-lg font-semibold text-white shadow-lg transition-all hover:bg-indigo-500 hover:shadow-indigo-500/25 active:scale-[0.98]"
      >
        Review & Submit
      </button>
    </form>
  </div>
</div>

<!-- Review Modal -->
<div id="reviewModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
  <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl bg-slate-800 p-6 shadow-2xl sm:p-8">
    <h2 class="mb-6 text-2xl font-bold text-white">Review Your Information</h2>

    <div class="space-y-4">
      <div class="rounded-xl bg-slate-700/50 p-4">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Business Name</p>
        <p id="reviewBusinessName" class="mt-1 text-lg text-white"></p>
      </div>

      <div class="rounded-xl bg-slate-700/50 p-4">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">About</p>
        <p id="reviewAbout" class="mt-1 whitespace-pre-wrap text-white"></p>
      </div>

      <div class="rounded-xl bg-slate-700/50 p-4">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Social Links</p>
        <p id="reviewSocialLinks" class="mt-1 whitespace-pre-wrap text-white"></p>
      </div>

      <div class="rounded-xl bg-slate-700/50 p-4">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Images</p>
        <p id="reviewImageCount" class="mt-1 text-white"></p>
        <div id="reviewImagePreviews" class="mt-3 grid grid-cols-4 gap-2"></div>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
      <button
        id="editBtn"
        type="button"
        class="flex-1 rounded-xl border border-slate-600 px-6 py-3 font-semibold text-white transition-all hover:bg-slate-700"
      >
        Edit
      </button>
      <button
        id="confirmBtn"
        type="button"
        class="flex-1 rounded-xl bg-emerald-600 px-6 py-3 font-semibold text-white transition-all hover:bg-emerald-500"
      >
        Confirm & Submit
      </button>
    </div>
  </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm">
  <div class="text-center">
    <div class="mx-auto h-12 w-12 animate-spin rounded-full border-4 border-indigo-500 border-t-transparent"></div>
    <p class="mt-4 text-lg font-medium text-white">Submitting...</p>
  </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
  <div class="w-full max-w-md rounded-2xl bg-slate-800 p-6 text-center shadow-2xl sm:p-8">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500/20">
      <svg class="h-8 w-8 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h2 class="mb-2 text-2xl font-bold text-white">Success!</h2>
    <p class="mb-6 text-slate-400">Your information has been submitted.</p>
    <button
      id="openWhatsAppBtn"
      type="button"
      class="w-full rounded-xl bg-emerald-600 px-6 py-4 font-semibold text-white transition-all hover:bg-emerald-500"
    >
      <span class="flex items-center justify-center gap-2">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Open WhatsApp
      </span>
    </button>
  </div>
</div>

<script define:vars={{ GOOGLE_SCRIPT_URL, WHATSAPP_NUMBER }}>
  // State
  let selectedFiles = [];
  let formData = {};
  let sheetRowUrl = '';

  // DOM Elements
  const form = document.getElementById('intakeForm');
  const imageInput = document.getElementById('imageInput');
  const dropZone = document.getElementById('dropZone');
  const imagePreviews = document.getElementById('imagePreviews');
  const reviewModal = document.getElementById('reviewModal');
  const loadingOverlay = document.getElementById('loadingOverlay');
  const successModal = document.getElementById('successModal');
  const editBtn = document.getElementById('editBtn');
  const confirmBtn = document.getElementById('confirmBtn');
  const openWhatsAppBtn = document.getElementById('openWhatsAppBtn');

  // Image handling
  function handleFiles(files) {
    const newFiles = Array.from(files).filter(file => file.type.startsWith('image/'));
    selectedFiles = [...selectedFiles, ...newFiles];
    renderPreviews();
  }

  function renderPreviews() {
    imagePreviews.innerHTML = '';
    selectedFiles.forEach((file, index) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const div = document.createElement('div');
        div.className = 'relative aspect-square';
        div.innerHTML = `
          <img src="${e.target.result}" class="h-full w-full rounded-lg object-cover" alt="Preview">
          <button type="button" data-index="${index}" class="remove-image absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-rose-500 text-white shadow-lg hover:bg-rose-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        `;
        imagePreviews.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  }

  // Event: Remove image
  imagePreviews.addEventListener('click', (e) => {
    const btn = e.target.closest('.remove-image');
    if (btn) {
      const index = parseInt(btn.dataset.index);
      selectedFiles.splice(index, 1);
      renderPreviews();
    }
  });

  // Event: File input change
  imageInput.addEventListener('change', (e) => handleFiles(e.target.files));

  // Event: Drag and drop
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-indigo-500', 'bg-slate-700/50');
  });

  dropZone.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-indigo-500', 'bg-slate-700/50');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-indigo-500', 'bg-slate-700/50');
    handleFiles(e.dataTransfer.files);
  });

  // Form submission - show review modal
  form.addEventListener('submit', (e) => {
    e.preventDefault();

    formData = {
      businessName: document.getElementById('businessName').value.trim(),
      about: document.getElementById('about').value.trim(),
      socialLinks: document.getElementById('socialLinks').value.trim()
    };

    // Populate review modal
    document.getElementById('reviewBusinessName').textContent = formData.businessName;
    document.getElementById('reviewAbout').textContent = formData.about;
    document.getElementById('reviewSocialLinks').textContent = formData.socialLinks || 'None provided';
    document.getElementById('reviewImageCount').textContent = `${selectedFiles.length} image(s) selected`;

    // Show image previews in modal
    const reviewPreviews = document.getElementById('reviewImagePreviews');
    reviewPreviews.innerHTML = '';
    selectedFiles.forEach((file) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = document.createElement('img');
        img.src = e.target.result;
        img.className = 'aspect-square w-full rounded-lg object-cover';
        reviewPreviews.appendChild(img);
      };
      reader.readAsDataURL(file);
    });

    reviewModal.classList.remove('hidden');
    reviewModal.classList.add('flex');
  });

  // Edit button - close modal
  editBtn.addEventListener('click', () => {
    reviewModal.classList.add('hidden');
    reviewModal.classList.remove('flex');
  });

  // Confirm button - submit to Google Apps Script
  confirmBtn.addEventListener('click', async () => {
    reviewModal.classList.add('hidden');
    reviewModal.classList.remove('flex');
    loadingOverlay.classList.remove('hidden');
    loadingOverlay.classList.add('flex');

    try {
      // Convert images to base64
      const imagePromises = selectedFiles.map(file => {
        return new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => resolve({
            name: file.name,
            type: file.type,
            data: e.target.result
          });
          reader.readAsDataURL(file);
        });
      });

      const images = await Promise.all(imagePromises);

      // Submit to Google Apps Script
      const response = await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors', // Google Apps Script requires this
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          businessName: formData.businessName,
          about: formData.about,
          socialLinks: formData.socialLinks,
          images: images,
          timestamp: new Date().toISOString()
        })
      });

      // Note: With no-cors mode, we can't read the response
      // The Google Apps Script should handle everything server-side
      sheetRowUrl = ''; // Would be populated from response if cors allowed

      loadingOverlay.classList.add('hidden');
      loadingOverlay.classList.remove('flex');
      successModal.classList.remove('hidden');
      successModal.classList.add('flex');

    } catch (error) {
      console.error('Submission error:', error);
      loadingOverlay.classList.add('hidden');
      loadingOverlay.classList.remove('flex');
      alert('There was an error submitting your form. Please try again.');
    }
  });

  // WhatsApp button
  openWhatsAppBtn.addEventListener('click', () => {
    const message = encodeURIComponent(
      `*New Client Intake*\n\n` +
      `*Business Name:* ${formData.businessName}\n\n` +
      `*About:* ${formData.about}\n\n` +
      `*Social Links:*\n${formData.socialLinks || 'None provided'}\n\n` +
      `*Images:* ${selectedFiles.length} uploaded\n\n` +
      (sheetRowUrl ? `*Sheet Link:* ${sheetRowUrl}` : '')
    );

    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`, '_blank');
  });

  // Close modals on backdrop click
  [reviewModal, successModal].forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });
  });
</script>

<style>
  /* Custom scrollbar for modal */
  #reviewModal > div::-webkit-scrollbar {
    width: 6px;
  }
  #reviewModal > div::-webkit-scrollbar-track {
    background: transparent;
  }
  #reviewModal > div::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 3px;
  }
</style>
